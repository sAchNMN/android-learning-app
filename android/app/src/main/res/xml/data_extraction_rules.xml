<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的备份与设备迁移规则：同样排除认证缓存。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
