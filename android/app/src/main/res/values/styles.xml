<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      排版六档：Display / Title / Section / RowTitle / Body / Caption。
      字号越大字距越紧，这是大标题看起来"挺"的原因；小字反而放松一点，
      否则中文小字挤成一团。全部关掉 includeFontPadding，按视觉边界对齐。
      颜色一律走主题属性 ?attr/au*：换主题、切深色时排版不用跟着改。
    -->
    <style name="Text" parent="">
        <item name="android:textColor">?attr/auInk</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Text.Display">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.035</item>
    </style>

    <style name="Text.Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>

    <style name="Text.Section">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="Text.RowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Body">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/auInkSecondary</item>
    </style>

    <style name="Text.Caption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/auInkTertiary</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- 时间码：等宽数字，播放时不会因为 1 和 0 宽度不同而抖动 -->
    <style name="Text.Numeric">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/auInkTertiary</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="Text.Segment">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.005</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Text.QuickLabel" parent="Text.Caption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">?attr/auInkSecondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!--
      封面圆角阶梯。ShapeableImageView 只认 shapeAppearance，
      不能直接写 app:cornerSize，所以按尺寸各给一个 overlay。
    -->
    <style name="Shape.Cover.Sm" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="Shape.Cover.Row" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Shape.Cover.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Shape.Cover.Hero" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Shape.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- 顶部圆形图标按钮（搜索、菜单、刷新） -->
    <style name="Widget.IconButton" parent="">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:background">@drawable/bg_circle_button</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <!-- 胶囊文字按钮（播放全部、更多） -->
    <style name="Widget.PillButton" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:background">@drawable/bg_pill_button</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/auInk</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 首页快捷入口：五等分、图标圆底 + 一行小字 -->
    <style name="Widget.QuickEntry" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>

    <!-- 我的页的三格数据 -->
    <style name="Widget.MineStat" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
    </style>

    <!--
      进出场不做系统默认的整屏滑动，改成短促淡入，接近 iOS 的转场节奏。
      Theme.Aurora 用 windowAnimationStyle 引用它，所以它必须留在手写的 styles 里，
      不能放进 themes.xml（那个文件由 tools/theme/gen_palette.py 生成）。
    -->
    <style name="Animation.Aurora.Window" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in_scale</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out_scale</item>
    </style>
</resources>