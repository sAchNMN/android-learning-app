<?xml version="1.0" encoding="utf-8"?>
<!--
  首页：一棵 RecyclerView + 一层骨架屏。
  列表 clipToPadding=false：滑起来内容会钻到状态栏和手势条下面，
  但静止时第一行标题仍然落在安全区里。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/auCanvas">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/homeList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="156dp"
        android:scrollbars="none" />

    <com.szc.learning.music.ui.widget.ShimmerSkeletonView
        android:id="@+id/homeSkeleton"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>