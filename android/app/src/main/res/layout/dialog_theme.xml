<?xml version="1.0" encoding="utf-8"?>
<!--
  外观面板：上半是明暗三档，下半是 5 套主题。
  主题行是数据驱动的（代码里按 AuroraTheme.entries 生成），所以这里只有容器。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/themeRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:paddingTop="10dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_dialog_handle" />

    <TextView
        style="@style/Text.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:text="@string/theme_title"
        android:textSize="17sp" />

    <!-- 三段胶囊：跟随系统 / 浅色 / 深色 -->
    <LinearLayout
        android:id="@+id/themeMode"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_segment_track"
        android:orientation="horizontal"
        android:padding="3dp" />

    <!-- 5 行主题，代码里填充 -->
    <LinearLayout
        android:id="@+id/themeList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp" />
</LinearLayout>