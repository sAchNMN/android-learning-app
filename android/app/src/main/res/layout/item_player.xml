<?xml version="1.0" encoding="utf-8"?>
<!--
  单页播放器：同一张封面既做背景也做主体，歌词在封面下方。
  整页仍然是一张「唱片」而不是视频：不创建 SurfaceView，也不为每一页起 ExoPlayer。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerPageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/auDarkCanvas">

    <ImageView
        android:id="@+id/playerBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.30"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_now_scrim" />

    <LinearLayout
        android:id="@+id/playerContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="84dp"
        android:paddingEnd="24dp"
        android:paddingBottom="112dp">

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="224dp"
            android:layout_height="224dp"
            android:layout_gravity="center_horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/playerCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/player_album"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/Shape.Cover.Hero" />

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:alpha="0.16"
                android:contentDescription="@null"
                android:src="@drawable/ic_music_note"
                app:tint="@color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/playerTitle"
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="?attr/auOnDark"
            android:textSize="23sp" />

        <TextView
            android:id="@+id/playerArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.7"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="?attr/auOnDark"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/playerAlbum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:alpha="0.42"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="?attr/auOnDark"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/playerLyrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.66"
            android:ellipsize="end"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:maxLines="5"
            android:minHeight="72dp"
            android:text="@string/player_lyrics_loading"
            android:textColor="?attr/auOnDark"
            android:textSize="12sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.szc.learning.music.ui.widget.SeekLine
            android:id="@+id/playerSeek"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/playerPosition"
                style="@style/Text.Numeric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/auOnDarkSecondary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/playerDuration"
                style="@style/Text.Numeric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/auOnDarkSecondary" />
        </LinearLayout>

        <!-- 传输控制 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/playerShuffle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_shuffle"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_shuffle"
                app:tint="?attr/auOnDark" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/playerPrev"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_previous"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_prev"
                app:tint="?attr/auOnDark" />

            <ImageButton
                android:id="@+id/playerPlay"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_play_circle"
                android:contentDescription="@string/player_pause"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause"
                app:tint="?attr/auInk" />

            <ImageButton
                android:id="@+id/playerNext"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_next"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_next"
                app:tint="?attr/auOnDark" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/playerRepeat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_repeat"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_repeat"
                app:tint="?attr/auOnDark" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/playerFavorite"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_like"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_heart"
                app:tint="?attr/auOnDark" />

            <ImageButton
                android:id="@+id/playerShare"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_share"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_share"
                app:tint="?attr/auOnDark" />

            <ImageButton
                android:id="@+id/playerMore"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_more"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_more_vert"
                app:tint="?attr/auOnDark" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>