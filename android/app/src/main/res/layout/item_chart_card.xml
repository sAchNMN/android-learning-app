<?xml version="1.0" encoding="utf-8"?>
<!-- 榜单卡：序号 + 榜名 + 前三首 + 播放键 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_mine_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/chartIndex"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:textColor="?attr/auAccent"
        android:textSize="22sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/chartTitle"
            style="@style/Text.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/chartSubtitle"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/chartPlay"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_quick_circle"
        android:contentDescription="@string/recommend_chart_play"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_play"
        app:tint="?attr/auAccent" />
</LinearLayout>