<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingBottom="136dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mine_title"
                    android:textSize="28sp" />

                <View
                    android:layout_width="22dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_tab_underline" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/mineTheme"
                style="@style/Widget.IconButton"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="@string/theme_button"
                android:src="@drawable/ic_palette"
                app:tint="?attr/auInk" />

            <ImageButton
                android:id="@+id/mineGlass"
                style="@style/Widget.IconButton"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="@string/glass_button"
                android:src="@drawable/ic_glass"
                app:tint="?attr/auInk" />

        </LinearLayout>

        <!-- 我喜欢 -->
        <LinearLayout
            android:id="@+id/mineFavoritesCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_mine_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/mineFavoritesCover"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/Shape.Cover.Row" />

            <TextView
                style="@style/Text.RowTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/mine_favorites_card"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/mineFavoritesPlay"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_quick_circle"
                android:contentDescription="@string/player_play"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                app:tint="?attr/auAccent" />
        </LinearLayout>

        <!-- 入口宫格 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mineEntries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <!-- 最近播放：整行可点进全部 -->
        <LinearLayout
            android:id="@+id/mineRecentHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_ripple_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="2dp">

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mine_recent_card" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/auInkTertiary" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mineRecent"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="20dp"
            android:paddingEnd="8dp"
            android:scrollbars="none" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>