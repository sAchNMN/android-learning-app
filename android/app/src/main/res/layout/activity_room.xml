<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/roomRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/auCanvas"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/roomBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/auInk" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/room_title"
            android:textColor="?attr/auInk" />
    </LinearLayout>

    <!-- 未进房间：建房 / 加入 -->
    <LinearLayout
        android:id="@+id/roomLobby"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/room_subtitle"
            android:textColor="?attr/auInkSecondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/roomCreateButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="@string/room_create"
            android:textSize="16sp"
            app:cornerRadius="26dp" />

        <EditText
            android:id="@+id/roomCodeInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:autofillHints=""
            android:backgroundTint="?attr/auHairline"
            android:gravity="center"
            android:hint="@string/room_code_hint"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters"
            android:letterSpacing="0.25"
            android:maxLength="6"
            android:textColor="?attr/auInk"
            android:textColorHint="?attr/auInkTertiary"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/roomJoinButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/room_join"
            android:textSize="16sp"
            app:cornerRadius="26dp" />
    </LinearLayout>

    <!-- 已进房间 -->
    <LinearLayout
        android:id="@+id/roomBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/room_code_tip"
            android:textColor="?attr/auInkSecondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/roomCodeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.35"
            android:textColor="?attr/auInk"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/roomCopy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_ripple_row"
            android:paddingStart="0dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:text="@string/room_copy_code"
            android:textColor="?attr/auAccent"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/roomModeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/auInk"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/roomLatency"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="?attr/auInkTertiary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/roomMemberTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="?attr/auInkSecondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/roomMembers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="?attr/auHairline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/roomLeaveButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/room_leave"
            android:textColor="?attr/auDanger"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
