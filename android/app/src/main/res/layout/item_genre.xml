<?xml version="1.0" encoding="utf-8"?>
<!-- 分类方块：彩色玻璃，颜色由适配器按分类注入，所以这里不写死 tint -->
<com.szc.learning.music.ui.widget.GlassView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/genreTile"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:layout_margin="5dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/genreName"
        style="@style/Text.RowTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="14dp"
        android:textSize="15sp" />
</com.szc.learning.music.ui.widget.GlassView>
