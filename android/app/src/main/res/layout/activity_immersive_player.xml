<?xml version="1.0" encoding="utf-8"?>
<!--
  沉浸式全屏播放 · 竖屏。
  深色舞台 + 放大封面的柔光 + 封面主色光晕与微尘；
  系统状态栏/导航栏由 Activity 隐藏，内容按刘海 insets 让位。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/immersiveRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/auDarkCanvas">

    <ImageView
        android:id="@+id/immersiveBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.32"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_now_scrim" />

    <com.szc.learning.music.ui.now.ImmersiveStageView
        android:id="@+id/immersiveStage"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/immersiveContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/immersiveClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_collapse"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_down"
                app:tint="?attr/auOnDark" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/immersiveQueue"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/queue_title"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_queue"
                app:tint="?attr/auOnDark" />

            <ImageButton
                android:id="@+id/immersiveMore"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_more"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_more_vert"
                app:tint="?attr/auOnDark" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="228dp"
            android:layout_height="228dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/immersiveCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/Shape.Cover.Hero" />

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:alpha="0.16"
                android:contentDescription="@null"
                android:src="@drawable/ic_music_note"
                app:tint="@color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/immersiveTitle"
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="?attr/auOnDark"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/immersiveArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.68"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="?attr/auOnDark"
            android:textSize="13sp" />

        <com.szc.learning.music.ui.widget.LyricView
            android:id="@+id/immersiveLyric"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:minHeight="120dp" />

        <com.szc.learning.music.ui.widget.SeekLine
            android:id="@+id/immersiveSeek"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/immersivePosition"
                style="@style/Text.Numeric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/auOnDarkSecondary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/immersiveDuration"
                style="@style/Text.Numeric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/auOnDarkSecondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/immersiveFavorite"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_like"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_heart"
                app:tint="?attr/auOnDark" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/immersivePrev"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_previous"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_prev"
                app:tint="?attr/auOnDark" />

            <ImageButton
                android:id="@+id/immersivePlay"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_play_circle"
                android:contentDescription="@string/player_play"
                android:padding="21dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                app:tint="?attr/auInk" />

            <ImageButton
                android:id="@+id/immersiveNext"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_next"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_next"
                app:tint="?attr/auOnDark" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/immersiveMode"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_repeat"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_repeat"
                app:tint="?attr/auOnDark" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
