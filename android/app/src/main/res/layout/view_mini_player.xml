<?xml version="1.0" encoding="utf-8"?>
<!--
  迷你播放器内部布局。根节点是 merge：MiniPlayerView 自己就是白卡容器。
  进度条压在卡片底部，细线不抢视线，但能看出"播到哪了"。
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/miniCover"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="9dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/Shape.Cover.Sm" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="62dp"
        android:layout_marginEnd="104dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/miniTitle"
            style="@style/Text.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/miniArtist"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/miniPlay"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="42dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_play"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_play"
        app:tint="?attr/auInk" />

    <ImageButton
        android:id="@+id/miniNext"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_next"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_next"
        app:tint="?attr/auInk" />

    <com.szc.learning.music.ui.widget.SeekLine
        android:id="@+id/miniProgress"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp" />
</merge>