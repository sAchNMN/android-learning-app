<?xml version="1.0" encoding="utf-8"?>
<!-- 正在播放：深色沉浸、封面居中、底部控件。
     背景 = 封面主色派生的纵向渐变（底层） + 一层预缩小的模糊封面（上层，低透明度）。
     换歌时渐变由 ArgbEvaluator 平滑过渡，所有 API 级别效果一致，不依赖 RenderEffect。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nowRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/auDarkCanvas">

    <!-- 底色渐变：颜色由 CoverPalette 从封面取，代码里设 GradientDrawable -->
    <View
        android:id="@+id/nowBackdropGradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/nowBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.35"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_now_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- 顶栏 -->
        <LinearLayout
            android:id="@+id/nowTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <ImageButton
                android:id="@+id/nowCollapse"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_collapse"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_down"
                app:tint="?attr/auOnDark" />

            <!-- 定时关闭生效时显示剩余时间，未设置时整块不占位 -->
            <TextView
                android:id="@+id/nowSleepHint"
                style="@style/Text.Numeric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="?attr/auOnDarkSecondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/nowMore"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_more"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_more"
                app:tint="?attr/auOnDark" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="272dp"
            android:layout_height="272dp"
            android:layout_marginTop="4dp"
            android:layout_gravity="center_horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/nowCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/Shape.Cover.Hero" />

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:alpha="0.26"
                android:contentDescription="@null"
                android:src="@drawable/ic_music_note"
                app:tint="@color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/nowTitle"
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="?attr/auOnDark"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/nowArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:alpha="0.68"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="?attr/auOnDark"
            android:textSize="13sp" />

        <com.szc.learning.music.ui.widget.LyricView
            android:id="@+id/nowLyric"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:minHeight="140dp" />

        <!-- 操作行：不喜欢 / 评论 / 队列，紧贴进度条上方 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/nowDislike"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_dislike"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_thumb_down"
                app:tint="?attr/auOnDark" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/nowComments"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/comment_title"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_comment"
                app:tint="?attr/auOnDark" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/nowQueue"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/queue_title"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_queue"
                app:tint="?attr/auOnDark" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
        </LinearLayout>

        <com.szc.learning.music.ui.widget.SeekLine
            android:id="@+id/nowSeek"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/nowPosition"
                style="@style/Text.Numeric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/auOnDarkSecondary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/nowDuration"
                style="@style/Text.Numeric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/auOnDarkSecondary" />
        </LinearLayout>

        <!-- 传输控制 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/nowFavorite"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_like"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_heart"
                app:tint="?attr/auOnDark" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/nowPrev"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_previous"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_prev"
                app:tint="?attr/auOnDark" />

            <ImageButton
                android:id="@+id/nowPlay"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_play_circle"
                android:contentDescription="@string/player_play"
                android:padding="21dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                app:tint="?attr/auInk" />

            <ImageButton
                android:id="@+id/nowNext"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_next"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_next"
                app:tint="?attr/auOnDark" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/nowMode"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_repeat"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_repeat"
                app:tint="?attr/auOnDark" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>