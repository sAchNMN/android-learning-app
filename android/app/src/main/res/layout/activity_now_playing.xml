<?xml version="1.0" encoding="utf-8"?>
<!--
  正在播放页。
  结构：模糊封面 → 压暗层 → 顶栏 / 居中主舞台 / 底栏。
  主舞台整体垂直居中，而不是从上往下堆 —— 这样不管屏幕多高，
  封面、文字、走带这一组的关系是恒定的，多余的空白平均分到上下，不会全挤在走带下面。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nowRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_now_scrim" />

    <!-- 顶栏：左右各一个等宽热区，保证中轴不偏 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageButton
            android:id="@+id/btnCollapse"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_collapse"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/white" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnQueue"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_queue"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_queue"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- 主舞台：封面尺寸在代码里按屏宽算，保证正方形且四周留白一致 -->
    <LinearLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/nowCover"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:contentDescription="@null"
            android:elevation="18dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/Shape.Cover.Hero" />

        <TextView
            android:id="@+id/nowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nowArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:alpha="0.76"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <com.szc.learning.music.ui.widget.SeekLine
            android:id="@+id/nowSeek"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timePosition"
                style="@style/Text.Numeric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/timeDuration"
                style="@style/Text.Numeric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white" />
        </LinearLayout>

        <!-- 走带：五个键左右对称，间距一致。主播放键是页面上唯一的实心白 -->
        <LinearLayout
            android:id="@+id/transport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnShuffle"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_shuffle"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_shuffle"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_previous"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_prev"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_transport_circle"
                android:contentDescription="@string/player_pause"
                android:elevation="4dp"
                android:padding="22dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause"
                app:tint="@color/black" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_next"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_next"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnRepeat"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_repeat"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_repeat"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/volumeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="26dp"
        android:paddingTop="8dp"
        android:paddingEnd="26dp"
        android:paddingBottom="18dp">

        <ImageView
            android:id="@+id/volumeIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:alpha="0.55"
            android:contentDescription="@null"
            android:src="@drawable/ic_volume"
            app:tint="@color/white" />

        <com.szc.learning.music.ui.widget.SeekLine
            android:id="@+id/volumeLine"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
