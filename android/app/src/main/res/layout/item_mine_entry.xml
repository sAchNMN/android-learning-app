<?xml version="1.0" encoding="utf-8"?>
<!-- 我的页入口：圆形图标 + 一行字，4 列宫格 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ripple_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_mine_entry_circle">

        <ImageView
            android:id="@+id/mineEntryIcon"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            app:tint="?attr/auAccent" />
    </FrameLayout>

    <TextView
        android:id="@+id/mineEntryLabel"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="?attr/auInkSecondary"
        android:textSize="11sp" />
</LinearLayout>