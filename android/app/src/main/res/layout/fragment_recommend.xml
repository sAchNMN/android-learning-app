<?xml version="1.0" encoding="utf-8"?>
<!-- 推荐页：每日推荐卡 + 为你推荐（可点红心）+ 音源歌单 + 本机歌单。
     内容铺到系统栏下面，靠 insets 让标题避让 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/auCanvas">

<androidx.core.widget.NestedScrollView
    android:id="@+id/recommendScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingBottom="136dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题 -->
        <LinearLayout
            android:id="@+id/recommendHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recommend_title"
                    android:textSize="28sp" />

                <View
                    android:layout_width="22dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_tab_underline" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/recommendRank"
                style="@style/Widget.IconButton"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="@string/rank_entry"
                android:src="@drawable/ic_rank"
                app:tint="?attr/auInk" />

            <ImageButton
                android:id="@+id/recommendSearch"
                style="@style/Widget.IconButton"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="@string/search_hint"
                android:src="@drawable/ic_search"
                app:tint="?attr/auInk" />

            <ImageButton
                android:id="@+id/recommendRefresh"
                style="@style/Widget.IconButton"
                android:layout_marginBottom="4dp"
                android:contentDescription="@string/recommend_refresh"
                android:src="@drawable/ic_refresh"
                app:tint="?attr/auInk" />
        </LinearLayout>

        <TextView
            android:id="@+id/recommendSubtitle"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:text="@string/recommend_offline"
            android:visibility="gone" />

        <!-- 每日推荐卡 -->
        <FrameLayout
            android:id="@+id/dailyCard"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_recommend_header"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/dailyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="20dp"
                android:paddingEnd="88dp"
                android:text="@string/recommend_daily_tag"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/dailyPlay"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_play_circle"
                android:contentDescription="@string/recommend_daily_play"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                app:tint="?attr/auAccent" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recommendTracks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/recommendEmpty"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/recommend_empty"
            android:visibility="gone" />

        <!-- 来自音源的歌单 -->
        <LinearLayout
            android:id="@+id/recommendSourceHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <TextView
                style="@style/Text.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/recommend_source_playlists" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recommendSourcePlaylists"
            android:layout_width="match_parent"
            android:layout_height="212dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="20dp"
            android:paddingEnd="8dp"
            android:scrollbars="none" />


        <!-- 推荐歌单（本机拼的） -->
        <LinearLayout
            android:id="@+id/recommendPlaylistsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <TextView
                style="@style/Text.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/recommend_playlists" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recommendPlaylists"
            android:layout_width="match_parent"
            android:layout_height="212dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="20dp"
            android:paddingEnd="8dp"
            android:scrollbars="none" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

    <com.szc.learning.music.ui.widget.ShimmerSkeletonView
        android:id="@+id/recommendSkeleton"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
