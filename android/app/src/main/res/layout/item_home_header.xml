<?xml version="1.0" encoding="utf-8"?>
<!--
  首页头部：大标题 / 搜索 / 轮播 / 五个快捷入口。
  轮播用 ViewPager2，指示点由代码按页数生成，不写死三个。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 标题行：音乐 / 视频 + 两个圆形按钮 -->
    <LinearLayout
        android:id="@+id/headerTitleRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_music"
                android:textSize="28sp" />

            <View
                android:layout_width="22dp"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_tab_underline" />
        </LinearLayout>

        <TextView
            android:id="@+id/headerVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/home_video"
            android:textColor="?attr/auInkSecondary"
            android:textSize="19sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/headerSearch"
            style="@style/Widget.IconButton"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ic_search"
            app:tint="?attr/auInk" />

        <ImageButton
            android:id="@+id/headerMenu"
            style="@style/Widget.IconButton"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ic_menu"
            app:tint="?attr/auInk" />
    </LinearLayout>

    <!-- 搜索条 -->
    <FrameLayout
        android:id="@+id/headerSearchBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_search_pill"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:tint="?attr/auInkTertiary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="43dp"
            android:text="@string/home_search_hint"
            android:textColor="?attr/auInkTertiary"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- 轮播主卡 -->
    <FrameLayout
        android:id="@+id/heroCard"
        android:layout_width="match_parent"
        android:layout_height="176dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_cover_hero">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/heroPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/heroDots"
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </FrameLayout>

    <!-- 快捷入口 -->
    <LinearLayout
        android:id="@+id/headerQuickRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:id="@+id/quickDaily"
            style="@style/Widget.QuickEntry"
            android:contentDescription="@string/home_quick_daily">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_quick_circle">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar"
                    app:tint="?attr/auAccent" />
            </FrameLayout>

            <TextView
                style="@style/Text.QuickLabel"
                android:text="@string/home_quick_daily" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quickChart"
            style="@style/Widget.QuickEntry"
            android:contentDescription="@string/home_quick_chart">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_quick_circle">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chart"
                    app:tint="?attr/auAccent" />
            </FrameLayout>

            <TextView
                style="@style/Text.QuickLabel"
                android:text="@string/home_quick_chart" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quickArtist"
            style="@style/Widget.QuickEntry"
            android:contentDescription="@string/home_quick_artist">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_quick_circle">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_mine"
                    app:tint="?attr/auAccent" />
            </FrameLayout>

            <TextView
                style="@style/Text.QuickLabel"
                android:text="@string/home_quick_artist" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quickFavorite"
            style="@style/Widget.QuickEntry"
            android:contentDescription="@string/home_quick_favorite">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_quick_circle">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_heart_filled"
                    app:tint="?attr/auAccent" />
            </FrameLayout>

            <TextView
                style="@style/Text.QuickLabel"
                android:text="@string/home_quick_favorite" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quickLocal"
            style="@style/Widget.QuickEntry"
            android:contentDescription="@string/home_quick_local">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_quick_circle">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_local"
                    app:tint="?attr/auAccent" />
            </FrameLayout>

            <TextView
                style="@style/Text.QuickLabel"
                android:text="@string/home_quick_local" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>