<?xml version="1.0" encoding="utf-8"?>
<!-- 推荐曲目行：封面 48 / 标题 + 歌手 / 平台角标 / 红心 / 时长。
     红心是这个列表存在的主要理由 —— 推荐里随手点收藏，会同步到音源与后台 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="66dp"
    android:background="@drawable/bg_ripple_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="10dp">

    <com.szc.learning.music.ui.widget.CoverImageView
        android:id="@+id/trackCover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:coverRadius="@dimen/radius_row" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/trackTitle"
            style="@style/Text.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/trackArtist"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/auInkSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/trackSource"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_source_badge"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textColor="?attr/auAccent"
        android:textSize="10sp"
        android:visibility="gone"
        tools:text="网易云"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/trackLike"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/recommend_like"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_heart"
        app:tint="?attr/auInkSecondary" />

    <TextView
        android:id="@+id/trackDuration"
        style="@style/Text.Numeric"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="6dp" />
</LinearLayout>
