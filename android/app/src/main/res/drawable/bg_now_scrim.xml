<?xml version="1.0" encoding="utf-8"?>
<!--
  正在播放页的背景压暗层。
  三段而不是两段：顶部要给收起按钮留可读区，中间让封面自己亮，
  底部再压深，白色控件才能从模糊封面里浮出来。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#59000000"
        android:centerY="0.42"
        android:endColor="#D9000000"
        android:startColor="#7A000000"
        android:type="linear" />
</shape>
