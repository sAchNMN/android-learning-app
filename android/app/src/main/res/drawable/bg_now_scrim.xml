<?xml version="1.0" encoding="utf-8"?>
<!--
  正在播放页的背景压暗层。
  三段：顶部给顶栏图标一点底、中间最轻（让封面本来的颜色透出来）、
  底部压深保证白色走带清晰。整体比"重压一层黑"要亮得多，封面才有存在感。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#2E000000"
        android:centerY="0.5"
        android:endColor="#B3000000"
        android:startColor="#4D000000"
        android:type="linear" />
</shape>
