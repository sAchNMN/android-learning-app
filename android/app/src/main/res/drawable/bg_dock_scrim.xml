<?xml version="1.0" encoding="utf-8"?>
<!--
  底部渐隐。
  没有真实背景模糊的时候，内容直接滚到玻璃底下会显得脏 —— 这层从透明渐变到画布色，
  相当于把压在 tab 栏下面的内容"擦掉"，玻璃才有浮起来的感觉。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:endColor="#00FFFFFF"
        android:startColor="@color/canvas"
        android:type="linear" />
</shape>
